// @effect grain "フィルムの粒子ノイズを加える"
// @label "フィルム粒子"
// @category style
// @param amount 0.15 0..1 "粒子の強さ（0 で何もしない）"
// @param seed 1 0..1000 "乱数の種（変えると粒子の配置が変わる）"
// @alias noise
// @whole
// @gpu 1

kernel function grainHash(n0: u32): f32 {
  let n = n0;
  n = (n ^ 61) ^ (n >> 16);
  n = n + (n << 3);
  n = n ^ (n >> 4);
  n = n * 668265261;
  n = n ^ (n >> 15);
  return ((n & 65535) as f32) / 32767.5 - 1.0;
}

export kernel function fx_gpu_grain(
  i: u32, dst: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>, orig: Buffer<vec4<f32>>,
  w: u32, h: u32, p: f32[8], pass: u32,
): void {
  const c = src[i];
  const amt = p[0];
  if (amt <= 0.0) {
    dst[i] = c;
    return;
  }
  const s = Math.max(Math.floor(p[1] + 0.5) as i32, 0) as u32;
  const g = grainHash(i + s * 2654435761) * amt * 0.35;
  dst[i] = vec4(
    Math.min(Math.max(c.x + g, 0.0), 1.0),
    Math.min(Math.max(c.y + g, 0.0), 1.0),
    Math.min(Math.max(c.z + g, 0.0), 1.0),
    c.w,
  );
}

kernel function grainCopy(i: u32, dst: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>): void {
  dst[i] = src[i];
}

export function fx_grain(layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, w: u32, h: u32, p: f32[8]): void {
  if (p[0] <= 0.0) {
    return;
  }
  const n = w * h;
  dispatch(fx_gpu_grain, n, mut tmp, layer, layer, w, h, p, 0 as u32);
  dispatch(grainCopy, n, mut layer, tmp);
}
