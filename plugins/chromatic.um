// @effect chromatic "色収差（赤と青を反対方向にずらしてレンズのにじみを出す）"
// @label "色収差"
// @category style
// @thumb 0=3
// @param shift 6 -64..64 "ずらす量（画素。0 で何もしない）"
// @param angle 0 -180..180 "ずらす方向の角度（度。0 で横、90 で縦）"
// @alias aberration
// @whole
// @gpu 1

kernel function chrSin(x0: f32): f32 {
  const PI: f32 = 3.14159265;
  let x = x0;
  while (x > PI) {
    x = x - 2.0 * PI;
  }
  while (x < -PI) {
    x = x + 2.0 * PI;
  }
  if (x > 0.5 * PI) {
    x = PI - x;
  } else if (x < -0.5 * PI) {
    x = -PI - x;
  }
  const x2 = x * x;
  return x * (1.0 - x2 * (1.0 / 6.0 - x2 * (1.0 / 120.0 - x2 * (1.0 / 5040.0))));
}

kernel function chrCos(x: f32): f32 {
  const PI: f32 = 3.14159265;
  return chrSin(x + 0.5 * PI);
}

kernel function chrCopy(i: u32, dst: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>): void {
  dst[i] = src[i];
}

export kernel function fx_gpu_chromatic(
  i: u32, dst: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>, orig: Buffer<vec4<f32>>,
  w: u32, h: u32, p: f32[8], pass: u32,
): void {
  if (p[0] == 0.0 || w == 0 || h == 0) {
    dst[i] = src[i];
    return;
  }
  const rad = p[1] * 0.0174532925;
  const dx = Math.floor(p[0] * chrCos(rad) + 0.5) as i32;
  const dy = Math.floor(p[0] * chrSin(rad) + 0.5) as i32;
  if (dx == 0 && dy == 0) {
    dst[i] = src[i];
    return;
  }
  const x = (i % w) as i32;
  const y = (i / w) as i32;
  const maxX = (w as i32) - 1;
  const maxY = (h as i32) - 1;
  const rx = Math.min(Math.max(x - dx, 0), maxX) as u32;
  const ry = Math.min(Math.max(y - dy, 0), maxY) as u32;
  const bx = Math.min(Math.max(x + dx, 0), maxX) as u32;
  const by = Math.min(Math.max(y + dy, 0), maxY) as u32;
  const cr = src[ry * w + rx];
  const cg = src[i];
  const cb = src[by * w + bx];
  dst[i] = vec4(cr.x, cg.y, cb.z, cg.w);
}

export function fx_chromatic(layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, w: u32, h: u32, p: f32[8]): void {
  if (p[0] == 0.0 || w == 0 || h == 0) {
    return;
  }
  const n = w * h;
  dispatch(fx_gpu_chromatic, n, mut tmp, layer, layer, w, h, p, 0 as u32);
  dispatch(chrCopy, n, mut layer, tmp);
}
