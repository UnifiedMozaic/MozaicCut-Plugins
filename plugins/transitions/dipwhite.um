// @transition dipwhite "一度白に飛ばしてから次の映像を出す"
// @label "白フェード（ディップ）"

export kernel function tr_gpu_dipwhite(
  i: u32, dst: mut Buffer<vec4<f32>>, a: Buffer<vec4<f32>>, b: Buffer<vec4<f32>>,
  w: u32, h: u32, progress: f32, angle: f32, soft: f32, param: f32,
): void {
  const p = Math.min(Math.max(progress, 0.0), 1.0);
  if (p < 0.5) {
    const t = p * 2.0;
    const ca = a[i];
    const q = 1.0 - t;
    dst[i] = vec4(ca.x * q + t, ca.y * q + t, ca.z * q + t, Math.max(ca.w, t));
  } else {
    const t = (p - 0.5) * 2.0;
    const cb = b[i];
    const q = 1.0 - t;
    dst[i] = vec4(q + cb.x * t, q + cb.y * t, q + cb.z * t, Math.max(cb.w, q));
  }
}

kernel function trDipWhiteCopy(i: u32, dst: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>): void {
  dst[i] = src[i];
}

export function tr_dipwhite(
  a: mut Buffer<vec4<f32>>, b: Buffer<vec4<f32>>, w: u32, h: u32,
  progress: f32, angle: f32, soft: f32, param: f32,
): void {
  const n = w * h;
  if (n == 0) {
    return;
  }
  let tmp = new Buffer<vec4<f32>>(n);
  dispatch(tr_gpu_dipwhite, n, mut tmp, a, b, w, h, progress, angle, soft, param);
  dispatch(trDipWhiteCopy, n, mut a, tmp);
}
