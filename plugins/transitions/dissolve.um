// @transition dissolve "前の映像と次の映像を滑らかに重ねて切り替える"
// @label "クロスディゾルブ"

export kernel function tr_gpu_dissolve(
  i: u32, dst: mut Buffer<vec4<f32>>, a: Buffer<vec4<f32>>, b: Buffer<vec4<f32>>,
  w: u32, h: u32, progress: f32, angle: f32, soft: f32, param: f32,
): void {
  const p = Math.min(Math.max(progress, 0.0), 1.0);
  const ca = a[i];
  const cb = b[i];
  const q = 1.0 - p;
  dst[i] = vec4(ca.x * q + cb.x * p, ca.y * q + cb.y * p, ca.z * q + cb.z * p, ca.w * q + cb.w * p);
}

kernel function trDissolveCopy(i: u32, dst: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>): void {
  dst[i] = src[i];
}

export function tr_dissolve(
  a: mut Buffer<vec4<f32>>, b: Buffer<vec4<f32>>, w: u32, h: u32,
  progress: f32, angle: f32, soft: f32, param: f32,
): void {
  const n = w * h;
  if (n == 0) {
    return;
  }
  let tmp = new Buffer<vec4<f32>>(n);
  dispatch(tr_gpu_dissolve, n, mut tmp, a, b, w, h, progress, angle, soft, param);
  dispatch(trDissolveCopy, n, mut a, tmp);
}
