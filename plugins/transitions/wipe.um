// @transition wipe "指定した角度（trans.angle）から境界をすべらせて切り替える"
// @label "リニアワイプ"

kernel function trWipeSin(rad: f32): f32 {
  const tau: f32 = 6.283185307;
  const pi: f32 = 3.141592654;
  let x = rad - Math.floor((rad + pi) / tau) * tau;
  const x2 = x * x;
  return x * (1.0 - x2 * (0.16666667 - x2 * (0.00833333 - x2 * 0.00019841)));
}

export kernel function tr_gpu_wipe(
  i: u32, dst: mut Buffer<vec4<f32>>, a: Buffer<vec4<f32>>, b: Buffer<vec4<f32>>,
  w: u32, h: u32, progress: f32, angle: f32, soft: f32, param: f32,
): void {
  const p = Math.min(Math.max(progress, 0.0), 1.0);
  const rad = angle * 0.0174532925;
  const dx = trWipeSin(rad + 1.570796327);
  const dy = trWipeSin(rad);
  const x = ((i % w) as f32 + 0.5) / (w as f32);
  const y = ((i / w) as f32 + 0.5) / (h as f32);
  const proj = (x - 0.5) * dx + (y - 0.5) * dy;
  const maxProj = 0.5 * (Math.abs(dx) + Math.abs(dy));
  const u = (proj + maxProj) / Math.max(2.0 * maxProj, 0.0001);
  const s = Math.max(soft, 0.002);
  const edge = p * (1.0 + s) - s * 0.5;
  const t = Math.min(Math.max((edge - u + s * 0.5) / s, 0.0), 1.0);
  const sm = t * t * (3.0 - 2.0 * t);
  const ca = a[i];
  const cb = b[i];
  const q = 1.0 - sm;
  dst[i] = vec4(ca.x * q + cb.x * sm, ca.y * q + cb.y * sm, ca.z * q + cb.z * sm, ca.w * q + cb.w * sm);
}

kernel function trWipeCopy(i: u32, dst: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>): void {
  dst[i] = src[i];
}

export function tr_wipe(
  a: mut Buffer<vec4<f32>>, b: Buffer<vec4<f32>>, w: u32, h: u32,
  progress: f32, angle: f32, soft: f32, param: f32,
): void {
  const n = w * h;
  if (n == 0) {
    return;
  }
  let tmp = new Buffer<vec4<f32>>(n);
  dispatch(tr_gpu_wipe, n, mut tmp, a, b, w, h, progress, angle, soft, param);
  dispatch(trWipeCopy, n, mut a, tmp);
}
