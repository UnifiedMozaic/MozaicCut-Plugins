// @transition iris "画面の中央から円形に開いて次の映像を出す"
// @label "アイリス（円形拡大）"

export kernel function tr_gpu_iris(
  i: u32, dst: mut Buffer<vec4<f32>>, a: Buffer<vec4<f32>>, b: Buffer<vec4<f32>>,
  w: u32, h: u32, progress: f32, angle: f32, soft: f32, param: f32,
): void {
  const p = Math.min(Math.max(progress, 0.0), 1.0);
  const wf = w as f32;
  const hf = h as f32;
  const aspect = wf / Math.max(hf, 1.0);
  const dx = (((i % w) as f32 + 0.5) / wf - 0.5) * aspect;
  const dy = ((i / w) as f32 + 0.5) / hf - 0.5;
  const dist = Math.sqrt(dx * dx + dy * dy);
  const maxR = Math.sqrt(0.25 * aspect * aspect + 0.25);
  const s = Math.max(soft, 0.002) * maxR;
  const rad = p * (maxR + s) - s * 0.5;
  const t = Math.min(Math.max((rad - dist + s * 0.5) / s, 0.0), 1.0);
  const sm = t * t * (3.0 - 2.0 * t);
  const ca = a[i];
  const cb = b[i];
  const q = 1.0 - sm;
  dst[i] = vec4(ca.x * q + cb.x * sm, ca.y * q + cb.y * sm, ca.z * q + cb.z * sm, ca.w * q + cb.w * sm);
}

kernel function trIrisCopy(i: u32, dst: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>): void {
  dst[i] = src[i];
}

export function tr_iris(
  a: mut Buffer<vec4<f32>>, b: Buffer<vec4<f32>>, w: u32, h: u32,
  progress: f32, angle: f32, soft: f32, param: f32,
): void {
  const n = w * h;
  if (n == 0) {
    return;
  }
  let tmp = new Buffer<vec4<f32>>(n);
  dispatch(tr_gpu_iris, n, mut tmp, a, b, w, h, progress, angle, soft, param);
  dispatch(trIrisCopy, n, mut a, tmp);
}
