// @effect ripple "波紋（水面に石を落としたような、中心から広がる輪のゆがみ）"
// @label "波紋"
// @category style
// @init 6
// @thumb 0=2 1=8
// @param amplitude 0 0..64 "揺れの幅（画素。0 で何もしない）"
// @param wavelength 40 4..512 "輪の間隔（画素）"
// @param phase 0 -3600..3600 "波の位相（度。キーフレームで増やすと輪が外へ広がる）"
// @param decay 1 0..8 "外へ行くほど弱まる度合い（0 で同じ強さのまま）"
// @param cx 0.5 0..1 "中心の横の位置（層の左端 0、右端 1）"
// @param cy 0.5 0..1 "中心の縦の位置（層の上端 0、下端 1）"
// @whole
// @gpu 1
//
// 中心からの距離 d の画素を、中心からの向きに amplitude × sin(2π d / 波長 - 位相) / (1 + decay × d / 短い辺) だけ
// ずらした所から取る（双線形補間）。

kernel function rippleSin(x0: f32): f32 {
  const PI: f32 = 3.14159265;
  let x = x0 - Math.floor(x0 / (2.0 * PI)) * 2.0 * PI;
  if (x > PI) {
    x = x - 2.0 * PI;
  }
  if (x > 0.5 * PI) {
    x = PI - x;
  } else if (x < -0.5 * PI) {
    x = -PI - x;
  }
  const x2 = x * x;
  return x * (1.0 - x2 * (1.0 / 6.0 - x2 * (1.0 / 120.0 - x2 * (1.0 / 5040.0))));
}

kernel function rippleTexel(src: Buffer<vec4<f32>>, x: i32, y: i32, w: u32, h: u32): vec4<f32> {
  const cx = Math.min(Math.max(x, 0), (w as i32) - 1) as u32;
  const cy = Math.min(Math.max(y, 0), (h as i32) - 1) as u32;
  return src[cy * w + cx];
}

kernel function rippleSample(src: Buffer<vec4<f32>>, fx: f32, fy: f32, w: u32, h: u32): vec4<f32> {
  const x = fx - 0.5;
  const y = fy - 0.5;
  const x0 = Math.floor(x);
  const y0 = Math.floor(y);
  const tx = x - x0;
  const ty = y - y0;
  const ix = x0 as i32;
  const iy = y0 as i32;
  const a = rippleTexel(src, ix, iy, w, h);
  const b = rippleTexel(src, ix + 1, iy, w, h);
  const c = rippleTexel(src, ix, iy + 1, w, h);
  const d = rippleTexel(src, ix + 1, iy + 1, w, h);
  const top = a + (b - a) * tx;
  const bot = c + (d - c) * tx;
  return top + (bot - top) * ty;
}

export kernel function fx_gpu_ripple(
  i: u32, dst: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>, orig: Buffer<vec4<f32>>,
  w: u32, h: u32, p: f32[8], pass: u32,
): void {
  if (p[0] == 0.0 || w == 0 || h == 0) {
    dst[i] = src[i];
    return;
  }
  const wf = w as f32;
  const hf = h as f32;
  const px = ((i % w) as f32) + 0.5;
  const py = ((i / w) as f32) + 0.5;
  const ox = p[4] * wf;
  const oy = p[5] * hf;
  const dx = px - ox;
  const dy = py - oy;
  const d = Math.sqrt(dx * dx + dy * dy);
  if (d < 0.0001) {
    dst[i] = src[i];
    return;
  }
  const wl = Math.max(p[1], 1.0);
  const fall = 1.0 / (1.0 + Math.max(p[3], 0.0) * d / Math.min(wf, hf));
  const off = p[0] * rippleSin(d * 6.2831853 / wl - p[2] * 0.0174532925) * fall;
  const k = (d + off) / d;
  dst[i] = rippleSample(src, ox + dx * k, oy + dy * k, w, h);
}

kernel function rippleCopy(i: u32, dst: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>): void {
  dst[i] = src[i];
}

export function fx_ripple(layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, w: u32, h: u32, p: f32[8]): void {
  if (p[0] == 0.0 || w == 0 || h == 0) {
    return;
  }
  const n = w * h;
  dispatch(fx_gpu_ripple, n, mut tmp, layer, layer, w, h, p, 0 as u32);
  dispatch(rippleCopy, n, mut layer, tmp);
}
