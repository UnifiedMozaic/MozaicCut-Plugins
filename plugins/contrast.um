// @effect contrast "コントラストを変える（0.5 を中心に掛ける）"
// @label "コントラスト"
// @category color
// @init 1.4
// @param amount 1 0..4 "倍率（1 でそのまま、0 で一面の灰色）"
// @gpu 1
//
// 色の効果なので、アルファは変えない。結果は 0..1 に収める。

export kernel function fx_gpu_contrast(
  i: u32, dst: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>, orig: Buffer<vec4<f32>>,
  w: u32, h: u32, p: f32[8], pass: u32,
): void {
  const c = src[i];
  const a = p[0];
  dst[i] = vec4(
    Math.min(Math.max((c.x - 0.5) * a + 0.5, 0.0), 1.0),
    Math.min(Math.max((c.y - 0.5) * a + 0.5, 0.0), 1.0),
    Math.min(Math.max((c.z - 0.5) * a + 0.5, 0.0), 1.0),
    c.w,
  );
}

kernel function contrastCopy(i: u32, dst: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>): void {
  dst[i] = src[i];
}

export function fx_contrast(layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, w: u32, h: u32, p: f32[8]): void {
  const n = w * h;
  dispatch(fx_gpu_contrast, n, mut tmp, layer, layer, w, h, p, 0 as u32);
  dispatch(contrastCopy, n, mut layer, tmp);
}
