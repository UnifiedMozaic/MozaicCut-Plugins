// @effect sat "彩度を変える（BT.709 の輝度を中心に掛ける）"
// @label "彩度"
// @category color
// @init 1.6
// @param amount 1 0..4 "倍率（1 でそのまま、0 で白黒）"
// @alias saturation
// @gpu 1
//
// 色の効果なので、アルファは変えない。結果は 0..1 に収める。

export kernel function fx_gpu_sat(
  i: u32, dst: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>, orig: Buffer<vec4<f32>>,
  w: u32, h: u32, p: f32[8], pass: u32,
): void {
  const c = src[i];
  const a = p[0];
  const l = 0.2126 * c.x + 0.7152 * c.y + 0.0722 * c.z;
  dst[i] = vec4(
    Math.min(Math.max(l + (c.x - l) * a, 0.0), 1.0),
    Math.min(Math.max(l + (c.y - l) * a, 0.0), 1.0),
    Math.min(Math.max(l + (c.z - l) * a, 0.0), 1.0),
    c.w,
  );
}

kernel function satCopy(i: u32, dst: mut Buffer<vec4<f32>>, src: Buffer<vec4<f32>>): void {
  dst[i] = src[i];
}

export function fx_sat(layer: mut Buffer<vec4<f32>>, tmp: mut Buffer<vec4<f32>>, w: u32, h: u32, p: f32[8]): void {
  const n = w * h;
  dispatch(fx_gpu_sat, n, mut tmp, layer, layer, w, h, p, 0 as u32);
  dispatch(satCopy, n, mut layer, tmp);
}
